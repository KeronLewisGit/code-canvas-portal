# Hostinger: the whole app lives in public_html, so route every request
# into the Laravel public/ folder and keep the rest of the tree private.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(\.env|\.git|vendor|storage|bootstrap|config|database|app|routes|resources|tests|artisan|composer\.(json|lock)|package(-lock)?\.json)(/|$) - [F,L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
