includes:
    - vendor/larastan/larastan/extension.neon
parameters:
    paths:
        - app
        - routes
        - database/seeders
    level: 6
    ignoreErrors:
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
        - identifier: nullsafe.neverNull
        - identifier: argument.templateType
        # Relation and date-cast types are not inferred for attribute-based models; runtime behaviour is covered by tests.
        - '#Eloquent\\Model::#'
        - '#Cannot call method [a-zA-Z]+\(\) on string#'
