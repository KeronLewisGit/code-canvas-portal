APP_NAME="Code Canvas Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://portal.codecanvastt.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# One file per day, kept 14 days, so the log never fills the hosting disk. Warnings include skipped emails.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u269010508_ccportal
DB_USERNAME=u269010508_ccportal
# Password: hPanel → Databases → MySQL Databases → u269010508_ccportal
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The site is HTTPS-only, so the sign-in cookie is never sent over plain HTTP.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting has no queue worker: send email during the request.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=smtp
# Sent through Zoho Mail, which the codecanvastt.com SPF/DKIM records already authorise.
# Host: Zoho Mail → Settings → Mail Accounts → SMTP (smtppro.zoho.com for most accounts; .eu/.in etc. by region).
# Needs a paid Zoho plan (the free plan blocks SMTP with "554 5.7.8 Access Restricted").
MAIL_SCHEME=smtps
MAIL_HOST=smtppro.zoho.com
MAIL_PORT=465
MAIL_USERNAME=mxadmin@codecanvastt.com
# A Zoho app-specific password (My Account → Security → App Passwords), not the mailbox password.
MAIL_PASSWORD=
# Must be the Zoho mailbox above (or one of its aliases), or Zoho rejects the message.
MAIL_FROM_ADDRESS="mxadmin@codecanvastt.com"
# Give up on a slow mail server after this many seconds instead of hanging the page.
MAIL_TIMEOUT=10
MAIL_FROM_NAME="${APP_NAME}"

# Company details printed on quotations and invoices (see config/company.php).
COMPANY_EMAIL=mxadmin@codecanvastt.com
COMPANY_PHONE="+1 (868) 275-3268"
COMPANY_ADDRESS="Trinidad and Tobago"
COMPANY_WEBSITE=https://codecanvastt.com
BANK_NAME="First Citizens Bank"
BANK_ACCOUNT_NAME="Code Canvas Consultants LTD"
BANK_ACCOUNT_TYPE=Chequing
BANK_ACCOUNT_NUMBER=3106054
BANK_BRANCH=
# Card payments through WiPay (hosted checkout). Leave WIPAY_ENABLED=false until you have tested in sandbox.
# Sandbox: account 1234567890, API key 123. Live: your WiPay account number, and the API key from WiPay's
# developer settings → Payment API (not the WAPI keys). Then set WIPAY_ENVIRONMENT=live.
WIPAY_ENABLED=false
WIPAY_ENVIRONMENT=sandbox
WIPAY_ACCOUNT_NUMBER=1234567890
WIPAY_API_KEY=123
# Who pays the card fee: merchant_absorb (you), customer_pay (added to the client's total) or split.
WIPAY_FEE_STRUCTURE=merchant_absorb

# First invoice number issued by the portal (continues the old Zoho sequence).
INVOICE_START_NUMBER=63

VITE_APP_NAME="${APP_NAME}"
